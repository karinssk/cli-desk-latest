{
  "name": "clideck",
  "version": "1.33.1",
  "description": "One screen for all your AI coding agents — run, monitor, and manage multiple CLI agents from a single browser tab",
  "main": "server.js",
  "bin": {
    "clideck": "bin/clideck.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tests/single-instance.test.js && node tests/clipboard-image.test.js && node tests/session-monitor.test.js && node tests/session-master.test.js && node tests/master-monitor.test.js",
    "build:css": "tailwindcss -i src/input.css -o public/tailwind.css --minify",
    "prepublishOnly": "npm run build:css"
  },
  "keywords": [
    "terminal",
    "cli",
    "ai",
    "agent",
    "claude",
    "codex",
    "gemini",
    "opencode",
    "dashboard",
    "multiplexer",
    "xterm"
  ],
  "author": "Or Kuntzman",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karinssk/cli-desk-latest.git"
  },
  "homepage": "https://github.com/karinssk/cli-desk-latest#readme",
  "bugs": { "url": "https://github.com/karinssk/cli-desk-latest/issues" },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.2.0-beta.15",
    "smol-toml": "^1.7.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
